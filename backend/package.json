{
  "name": "backend",
  "version": "1.0.0",
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "nodemon src/index.js",
    "worker": "node src/workers/ingestion.worker.js",
    "worker:folder": "node src/workers/folderIngestion.worker.js",
    "worker:docgen": "node src/workers/documentGeneration.worker.js",
    "worker:docexpiry": "node src/workers/documentExpiry.worker.js",
    "test": "node --test \"test/**/*.test.js\"",
    "dev:all": "concurrently \"npm run dev\" \"npm run worker\" \"npm run worker:folder\" \"npm run worker:docgen\" \"npm run worker:docexpiry\"",
    "start:all": "concurrently --kill-others-on-fail \"npm run start\" \"npm run worker\" \"npm run worker:folder\" \"npm run worker:docgen\" \"npm run worker:docexpiry\"",
    "build": "echo 'No build step required'"
  },
